<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rbsf_mvsim</name>
  <version>0.0.0</version>
  <description>ROS2 package for saving some custom mvsim worlds developed as part of Fernando Villa`s final degree project</description>
  <maintainer email="fernando.villa@edu.uah.es">Fernando Villa</maintainer>
  <license>Apache-2.0</license>
  
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros2launch</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
