<mvsim_world version="1.0">
	<!-- General simulation options -->
	<simul_timestep>0</simul_timestep> <!-- Simulation fixed-time interval for numerical integration [seconds] or 0 to autodetermine -->

	<!-- GUI options -->
	<gui>
		<ortho>true</ortho>
		<show_forces>true</show_forces>  <force_scale>0.01</force_scale>
		<cam_distance>20</cam_distance>
		<fov_deg>20</fov_deg>
		<refresh_fps>20</refresh_fps>
	</gui>

	<!-- Light parameters -->
	<lights>
	</lights>

	<!-- ========================
		   Scenario definition
	     ======================== -->
	
    <!-- ground -->
	<element class="horizontal_plane">
		<cull_face>BACK</cull_face>
		<x_min>-10</x_min> <y_min>-10</y_min>
		<x_max> 10</x_max> <y_max> 10</y_max>
		<z>0.0</z>
		<texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/PavingStone07_1K_BaseColor.png</texture>
		<texture_size_x>3.0</texture_size_x>
		<texture_size_y>2.0</texture_size_y>
	</element>

	<!-- Wall definition -->
	<element class="vertical_plane">
		<x0>3</x0>
		<y0>3</y0>
		<x1>3</x1>
		<y1>-3</y1>
		<z>0.0</z>
        <height>1.0</height>
        <texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/BrickWall01_1K_BaseColor.png</texture>
		<texture_size_x>3.0</texture_size_x>
		<texture_size_y>2.0</texture_size_y>
	</element>

