	</element>

	<!-- =============================
		   Vehicle classes definition
	     ============================= -->
    <include file="../definitions/traxxas-ford-st.vehicle.xml" 
		default_sensors="false"
	/>

    <vehicle name="r1" class="traxxas-ford-st">
		<init_pose>-2.5 -2.5 0</init_pose>
		<init_vel>0 0 0</init_vel>  

        <animation type="keyframes">
			<time_pose>0.0  0  0 0</time_pose>
			<time_pose>4.0  2.5  0 0</time_pose>
            <time_pose> 6.0 2.5 0 90</time_pose>
			<time_pose> 8.0 2.5 1.7 90</time_pose>
			<time_pose> 10.0 2.5 1.7 180</time_pose>
			<time_pose> 12.0 0.2 1.7 180</time_pose>
			<time_pose> 14.0 0.2 1.7 270</time_pose>
			<time_pose> 16.0 0 0 270</time_pose>
			<time_pose> 18.0 0 0 360</time_pose>
		</animation>
		 
		<include file="../definitions/lidar2d.sensor.xml" 
			sensor_x="0.4" 
			sensor_z="0.2709" 
			sensor_yaw="0" 
			max_range="30.0" 
			sensor_name="laser1"
		/>
	</vehicle>

